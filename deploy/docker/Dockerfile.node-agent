FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /bin/node-agent ./cmd/node-agent

FROM gcr.io/distroless/static-debian12

COPY --from=builder /bin/node-agent /node-agent

ENTRYPOINT ["/node-agent"]
